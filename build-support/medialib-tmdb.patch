new file mode 100644
index 0000000..aab6428
--- /dev/null
+++ b/test/java/com/archos/mediascraper/TmdbApiKeyTest.java
@@ -0,0 +1,48 @@
+package com.archos.mediascraper;
+
+import static org.junit.Assert.assertEquals;
+
+import android.content.Context;
+import androidx.preference.PreferenceManager;
+import androidx.test.core.app.ApplicationProvider;
+
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.annotation.Config;
+
+@RunWith(RobolectricTestRunner.class)
+@Config(sdk = 33)
+public class TmdbApiKeyTest {
+    private Context context;
+
+    @Before public void setUp() {
+        context = ApplicationProvider.getApplicationContext();
+        PreferenceManager.getDefaultSharedPreferences(context).edit().clear().commit();
+    }
+
+    @Test public void savedUserKeyOverridesPackagedFallback() {
+        PreferenceManager.getDefaultSharedPreferences(context).edit()
+                .putString("tmdb_api_key", "  user-supplied-test-key  ").commit();
+        assertEquals("user-supplied-test-key", TmdbApiKey.get(context));
+    }
+
+    @Test public void missingOrBlankKeyNeverUsesPackagedDeveloperCredential() {
+        assertEquals("", TmdbApiKey.get(context));
+        PreferenceManager.getDefaultSharedPreferences(context).edit()
+                .putString("tmdb_api_key", " \t ").commit();
+        assertEquals("", TmdbApiKey.get(context));
+    }
+
+    @Test public void readsChangedAndRemovedKeyWithoutRestart() {
+        PreferenceManager.getDefaultSharedPreferences(context).edit()
+                .putString("tmdb_api_key", "first-test-key").commit();
+        assertEquals("first-test-key", TmdbApiKey.get(context));
+        PreferenceManager.getDefaultSharedPreferences(context).edit()
+                .putString("tmdb_api_key", "second-test-key").commit();
+        assertEquals("second-test-key", TmdbApiKey.get(context));
+        PreferenceManager.getDefaultSharedPreferences(context).edit().remove("tmdb_api_key").commit();
+        assertEquals("", TmdbApiKey.get(context));
+    }
+}
