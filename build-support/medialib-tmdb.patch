@@ -0,0 +1,19 @@
+package com.archos.mediascraper;
+
+import android.content.Context;
+import androidx.preference.PreferenceManager;
+
+
+/** Runtime credential override shared by movie, TV and collection scrapers. */
+public final class TmdbApiKey {
+    public static final String PREFERENCE_KEY = "tmdb_api_key";
+
+    private TmdbApiKey() {}
+
+    /** Blank/unset keys stay empty, even if upstream resources contain a developer key. */
+    public static String get(Context context) {
+        String key = PreferenceManager.getDefaultSharedPreferences(context)
+                .getString(PREFERENCE_KEY, "");
+        return key == null ? "" : key.trim();
+    }
+}
