@@ -0,0 +1,83 @@
+package com.archos.mediascraper;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNotSame;
+import static org.junit.Assert.assertSame;
+
+import android.content.Context;
+import androidx.preference.PreferenceManager;
+import androidx.test.core.app.ApplicationProvider;
+
+import com.archos.mediascraper.xml.MovieScraper3;
+import com.archos.mediascraper.xml.ShowScraper4;
+import java.lang.reflect.Field;
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+import org.robolectric.annotation.Config;
+
+@RunWith(RobolectricTestRunner.class)
+@Config(sdk = 33)
+public class TmdbCredentialRefreshTest {
+    private Context context;
+
+    @Before public void setUp() {
+        context = ApplicationProvider.getApplicationContext();
+        save("initial-test-key");
+    }
+
+    private void save(String key) {
+        PreferenceManager.getDefaultSharedPreferences(context).edit()
+                .putString("tmdb_api_key", key).commit();
+    }
+
+    private static Object field(Class<?> type, String name) throws Exception {
+        Field f = type.getDeclaredField(name);
+        f.setAccessible(true);
+        return f.get(null);
+    }
+
+    @Test public void moviesUseSavedKeyAndRefreshEveryCachedService() throws Exception {
+        new MovieScraper3(context);
+        Object tmdb = MovieScraper3.getTmdb();
+        Object search = MovieScraper3.getSearchService();
+        Object movies = MovieScraper3.getMoviesService();
+        Object collections = MovieScraper3.getCollectionService();
+        assertEquals("initial-test-key", field(MovieScraper3.class, "apiKey"));
+        assertSame(tmdb, MovieScraper3.getTmdb());
+        save("replacement-test-key");
+        assertNotSame(search, MovieScraper3.getSearchService());
+        assertNotSame(movies, MovieScraper3.getMoviesService());
+        assertNotSame(collections, MovieScraper3.getCollectionService());
+        assertNotSame(tmdb, MovieScraper3.getTmdb());
+        assertEquals("replacement-test-key", field(MovieScraper3.class, "apiKey"));
+        save("");
+        MovieScraper3.getMoviesService();
+        assertEquals("", field(MovieScraper3.class, "apiKey"));
+    }
+
+    @Test public void showsRefreshExistingClientWithoutReconstruction() throws Exception {
+        new ShowScraper4(context);
+        Object tmdb = ShowScraper4.getTmdb();
+        assertEquals("initial-test-key", field(ShowScraper4.class, "apiKey"));
+        assertSame(tmdb, ShowScraper4.getTmdb());
+        save("replacement-test-key");
+        assertNotSame(tmdb, ShowScraper4.getTmdb());
+        assertEquals("replacement-test-key", field(ShowScraper4.class, "apiKey"));
+    }
+
+    @Test public void collectionsRefreshExistingServiceWithoutRestart() throws Exception {
+        // Supply only the application context: starting the Android service would also
+        // start its worker thread/notification, unrelated to credential resolution.
+        Field f = AllCollectionScrapeService.class.getDeclaredField("credentialContext");
+        f.setAccessible(true);
+        f.set(null, context);
+        Object service = AllCollectionScrapeService.getCollectionService();
+        assertEquals("initial-test-key", field(AllCollectionScrapeService.class, "apiKey"));
+        assertSame(service, AllCollectionScrapeService.getCollectionService());
+        save("replacement-test-key");
+        assertNotSame(service, AllCollectionScrapeService.getCollectionService());
+        assertEquals("replacement-test-key", field(AllCollectionScrapeService.class, "apiKey"));
+    }
+}
